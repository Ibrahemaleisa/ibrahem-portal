# Build-time (public) settings. Copy to .env.local for local builds.
NEXT_PUBLIC_SITE_URL=https://example.com
# Where the form posts. Default is the Pages Function at /api/contact.
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact
# Optional: Cloudflare Turnstile site key (pair with TURNSTILE_SECRET_KEY on the function)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Show "to confirm" markers for unverified content. Set to "false" for the public launch.
NEXT_PUBLIC_SHOW_DRAFT_NOTES=true
